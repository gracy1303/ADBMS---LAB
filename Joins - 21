CREATE TABLE department (
    dept_id NUMBER(5) PRIMARY KEY,
    dept_name VARCHAR2(30)
);

CREATE TABLE employee2 (
    emp_id NUMBER(5) PRIMARY KEY,
    emp_name VARCHAR2(30),
    dept_id NUMBER(5)
);
